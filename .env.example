# Storage backend: local or r2
LAKE_BACKEND=local
LAKE_ROOT=./data/lake
DUCKDB_PATH=data/oss_pulse.duckdb

# Cloudflare R2 (required when LAKE_BACKEND=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# MotherDuck (optional; local DuckDB is used in development)
MOTHERDUCK_TOKEN=your-motherduck-token
MOTHERDUCK_DATABASE=your-motherduck-database
# Use `dbt build --target prod` to read R2 into MotherDuck.
DBT_TARGET=dev

# Optional notifications
DISCORD_WEBHOOK_URL=

# Optional GitHub REST API token; unauthenticated requests are also supported.
GITHUB_TOKEN=
REPO_METADATA_TOP_N=50
